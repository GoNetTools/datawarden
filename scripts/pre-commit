#!/bin/sh
# Git pre-commit hook without the pre-commit framework:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Scans the staged content of staged files for committed personal data.
# Bypass once with: git commit --no-verify
command -v piiflow >/dev/null 2>&1 || { echo "piiflow not installed; skipping PII check" >&2; exit 0; }
exec piiflow scan --staged --no-cache
